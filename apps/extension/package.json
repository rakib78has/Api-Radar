{
  "name": "@api-qa/extension",
  "version": "0.1.0",
  "private": true,
  "description": "API QA Inspector Chrome extension (Manifest V3).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "validate:manifest": "node scripts/validate-manifest.ts dist",
    "validate:manifest:e2e": "node scripts/validate-manifest.ts dist-e2e --e2e"
  },
  "dependencies": {
    "@api-qa/contracts": "workspace:*",
    "@api-qa/core": "workspace:*",
    "@api-qa/reporting": "workspace:*",
    "@api-qa/storage": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.4"
  }
}
