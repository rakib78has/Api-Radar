{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Root-level TypeScript files (tool configs and repository tests). These run in Node.js and resolve workspace packages to their sources, like tsconfig.workspace.json.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@api-qa/contracts": ["./packages/contracts/src/index.ts"],
      "@api-qa/core": ["./packages/core/src/index.ts"],
      "@api-qa/storage": ["./packages/storage/src/index.ts"],
      "@api-qa/reporting": ["./packages/reporting/src/index.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["tests/e2e"]
}
